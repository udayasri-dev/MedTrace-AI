# GEMINI_API_KEY: Required for Gemini AI conversational reasoning and medical translation.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# HINDSIGHT_API_KEY: Optional API key for Hindsight Cloud Long-Term Memory Service.
# When provided, MedTrace synchronizes memory retain/recall directly with Hindsight.
# When omitted, MedTrace seamlessly operates via the Local Persistent Memory Engine.
HINDSIGHT_API_KEY=""
HINDSIGHT_API_URL="https://api.hindsight.vectorize.io/v1"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
